#!/bin/sh
# Blocks commit messages that contain the API key.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

for py in \
  "$ROOT/.venv/Scripts/python.exe" \
  "$ROOT/.venv/bin/python" \
  "$USERPROFILE/.venvs/tensorforge/Scripts/python.exe" \
  "$HOME/.venvs/tensorforge/bin/python" \
  python3 python; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then
    exec "$py" scripts/check_secrets.py --message "$1"
  fi
done
if command -v py >/dev/null 2>&1; then
  exec py -3 scripts/check_secrets.py --message "$1"
fi
echo "commit-msg: no Python found; refusing to commit without a secret scan." >&2
exit 1
