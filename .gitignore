# ---------------------------------------------------------------
# Secrets: NEVER commit these. The API key lives only in .env
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------
# Organizer dataset: not redistributable, keep out of the public repo.
# Download it from the official link (see README.md) into data/.
# ---------------------------------------------------------------
data/*
!data/.gitkeep
!data/README.md

# ---------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Notebook outputs may contain data samples; strip before commit
# (nbstripout is listed in requirements-dev.txt)

# ---------------------------------------------------------------
# ML working files (large / reproducible)
# ---------------------------------------------------------------
ml/runs/
ml/cache/
ml/checkpoints/
*.ckpt
*.pt
*.pth
wandb/
lightning_logs/
mlruns/

# Final deployable artifacts are tracked deliberately (see artifacts/README.md).
# Everything else under artifacts/ stays local until frozen.
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md
!artifacts/manifest.json
!artifacts/fusion.json
!artifacts/classical.joblib
!artifacts/tokenizer.json
!artifacts/encoder_meta.json
!artifacts/encoder.int8.onnx

# ---------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/runtime/
*.log

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Organizer booklet: keep local, not redistributed
docs/organizer/
