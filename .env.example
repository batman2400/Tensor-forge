# Copy this file to .env and fill in real values. .env is gitignored.
# NEVER put the real key in this file, the README, tests, the Dockerfile or screenshots.

# Evaluation API key issued by the organizers (starts with tf2_).
# The service reads it from the environment at startup and refuses to
# serve prediction endpoints (401) if it is missing.
API_KEY=

# Optional runtime tuning (defaults are fine for the 2 vCPU / 4 GB target)
# PORT=8000
# LOG_LEVEL=info
# JOB_DB_PATH=/data/jobs.sqlite3
# INFERENCE_THREADS=2

# Optional: base URL used by the hosted end-to-end tests (no trailing slash)
# TF_BASE_URL=https://<label>.<region>.cloudapp.azure.com
